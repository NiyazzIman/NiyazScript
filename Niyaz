local function GQSNVQ_fake_script() -- WalkSpeed.WalkSpeed 
	local script = Instance.new('LocalScript', WalkSpeed)

	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local walkSpeedButton = script.Parent
	local frame = walkSpeedButton.Parent
	
	local normalWalkSpeed = 16
	local fastWalkSpeed = frame:GetAttribute("WalkSpeedValue") or 50
	local fastWalkSpeedEnabled = false
	
	local function updateWalkSpeed()
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid")
		fastWalkSpeed = frame:GetAttribute("WalkSpeedValue") or fastWalkSpeed
	
		if fastWalkSpeedEnabled then
			humanoid.WalkSpeed = fastWalkSpeed
			walkSpeedButton.Text = "WalkSpeed: ON"
			walkSpeedButton.BackgroundColor3 = Color3.fromRGB(30, 180, 80)
		else
			humanoid.WalkSpeed = normalWalkSpeed
			walkSpeedButton.Text = "WalkSpeed"
			walkSpeedButton.BackgroundColor3 = Color3.fromRGB(165, 50, 165)
		end
	end
	
	frame:GetAttributeChangedSignal("WalkSpeedValue"):Connect(function()
		if fastWalkSpeedEnabled then
			updateWalkSpeed()
		end
	end)
	
	walkSpeedButton.Active = true
	walkSpeedButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			fastWalkSpeedEnabled = not fastWalkSpeedEnabled
			updateWalkSpeed()
		end
	end)
	
	player.CharacterAdded:Connect(function()
		updateWalkSpeed()
	end)
	
	updateWalkSpeed()
end
