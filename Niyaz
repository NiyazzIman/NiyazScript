local function OGUL_fake_script() -- ScriptUi.CloseAndHide 
	local script = Instance.new('LocalScript', ScriptUi)

	local UserInputService = game:GetService("UserInputService")
	local ui = script.Parent
	
	local dragging = false
	local dragStart
	local startPosition
	
	ui.Active = true
	
	ui.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPosition = ui.Position
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local difference = input.Position - dragStart
	
			ui.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + difference.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + difference.Y
			)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	
	local UserInputService = game:GetService("UserInputService")
	
	local ui = script.Parent
	
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
	
		if input.KeyCode == Enum.KeyCode.RightControl then
			ui.Visible = not ui.Visible
		end
	end)
	
end
coroutine.wrap(OGUL_fake_script)()
local function BMGGG_fake_script() -- ScriptUi.Tabs 
	local script = Instance.new('LocalScript', ScriptUi)

	local frame = script.Parent
	local tabBar = frame:WaitForChild("TabsButton")
	
	local mainTab = tabBar:WaitForChild("MainButton")
	local secondTab = tabBar:WaitForChild("ESPButton")
	local mainPage = frame:WaitForChild("MainTab")
	local secondPage = frame:WaitForChild("ESPPage")
	
	mainPage.ZIndex = 1
	secondPage.ZIndex = 1
	tabBar.ZIndex = 10
	mainTab.ZIndex = 11
	secondTab.ZIndex = 11
	
	local activeColor = Color3.fromRGB(30, 180, 80)
	local inactiveColor = Color3.fromRGB(165, 50, 165)
	
	local function showPage(page, selectedTab)
		mainPage.Visible = page == mainPage
		secondPage.Visible = page == secondPage
	
		mainTab.BackgroundColor3 = selectedTab == mainTab and activeColor or inactiveColor
		secondTab.BackgroundColor3 = selectedTab == secondTab and activeColor or inactiveColor
	end
	
	mainTab.Activated:Connect(function()
		showPage(mainPage, mainTab)
	end)
	
	secondTab.Activated:Connect(function()
		showPage(secondPage, secondTab)
	end)
	
	showPage(mainPage, mainTab)
	
end
