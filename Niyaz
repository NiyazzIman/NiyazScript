local function JKJYEBA_fake_script() -- Fly.LocalScript 
	local script = Instance.new('LocalScript', Fly)

	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local flyButton = script.Parent
	local frame = flyButton.Parent
	
	local flying = false
	local flySpeed = frame:GetAttribute("FlySpeedValue") or 60
	local flightConnection
	local flightVelocity
	local flightAttachment
	
	local function updateButtonVisual()
		if flying then
			flyButton.Text = "Fly: ON"
			flyButton.BackgroundColor3 = Color3.fromRGB(30, 180, 80)
		else
			flyButton.Text = "Fly"
			flyButton.BackgroundColor3 = Color3.fromRGB(165, 50, 165)
		end
	end
	
	local function setFlying(enabled)
		flying = enabled
	
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	
		if not humanoid or not rootPart then
			flying = false
			updateButtonVisual()
			return
		end
	
		humanoid.AutoRotate = not flying
		humanoid.PlatformStand = flying
	
		if flightConnection then
			flightConnection:Disconnect()
			flightConnection = nil
		end
		if flightVelocity then
			flightVelocity:Destroy()
			flightVelocity = nil
		end
		if flightAttachment then
			flightAttachment:Destroy()
			flightAttachment = nil
		end
	
		if flying then
			flightAttachment = Instance.new("Attachment")
			flightAttachment.Name = "FlightAttachment"
			flightAttachment.Parent = rootPart
	
			flightVelocity = Instance.new("LinearVelocity")
			flightVelocity.Name = "FlightVelocity"
			flightVelocity.Attachment0 = flightAttachment
			flightVelocity.MaxForce = math.huge
			flightVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
			flightVelocity.VectorVelocity = Vector3.zero
			flightVelocity.Parent = rootPart
	
			flightConnection = RunService.Heartbeat:Connect(function()
				local camera = workspace.CurrentCamera
				if not camera or not rootPart.Parent then
					return
				end
	
				flySpeed = frame:GetAttribute("FlySpeedValue") or flySpeed
	
				local lookDirection = camera.CFrame.LookVector
				rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + lookDirection)
				rootPart.AssemblyAngularVelocity = Vector3.zero
	
				local direction = Vector3.zero
	
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then
					direction = direction + camera.CFrame.LookVector
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then
					direction = direction - camera.CFrame.LookVector
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then
					direction = direction + camera.CFrame.RightVector
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then
					direction = direction - camera.CFrame.RightVector
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
					direction = direction + Vector3.yAxis
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
					direction = direction - Vector3.yAxis
				end
	
				flightVelocity.VectorVelocity = direction.Magnitude > 0
					and direction.Unit * flySpeed
					or Vector3.zero
			end)
		else
			rootPart.AssemblyLinearVelocity = Vector3.zero
		end
	
		updateButtonVisual()
	end
	
	flyButton.Active = true
	flyButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			setFlying(not flying)
		end
	end)
	
	-- Reset flying state when the character respawns
	player.CharacterAdded:Connect(function(character)
		if flying then
			flying = false
			if flightConnection then
				flightConnection:Disconnect()
				flightConnection = nil
			end
			updateButtonVisual()
		end
	end)
	
end
coroutine.wrap(JKJYEBA_fake_script)()
local function RIMFO_fake_script() -- WalkSpeedSlider.WalkSpeedSlider 
	local script = Instance.new('LocalScript', WalkSpeedSlider)

	local UserInputService = game:GetService("UserInputService")
	
	local speedSlider = script.Parent
	local frame = speedSlider.Parent
	local speedTrack = speedSlider:WaitForChild("Track")
	local speedKnob = speedTrack:WaitForChild("Knob")
	local speedText = speedSlider:WaitForChild("SpeedText")
	
	local minWalkSpeed = 16
	local maxWalkSpeed = 100
	local walkSpeed = minWalkSpeed
	local sliderDragging = false
	
	local function updateWalkSpeed(inputX)
		local percent = math.clamp(
			(inputX - speedTrack.AbsolutePosition.X) / speedTrack.AbsoluteSize.X,
			0,
			1
		)
	
		walkSpeed = math.round(minWalkSpeed + (maxWalkSpeed - minWalkSpeed) * percent)
		speedKnob.Position = UDim2.new(percent, 0, 0.5, 0)
		speedText.Text = "WalkSpeed: " .. walkSpeed
		frame:SetAttribute("WalkSpeedValue", walkSpeed)
	end
	
	speedTrack.Active = true
	speedTrack.ClipsDescendants = true
	speedKnob.Active = true
	
	local function beginSliderDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliderDragging = true
			updateWalkSpeed(input.Position.X)
		end
	end
	
	speedTrack.InputBegan:Connect(beginSliderDrag)
	speedKnob.InputBegan:Connect(beginSliderDrag)
	
	UserInputService.InputChanged:Connect(function(input)
		if sliderDragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			) then
			updateWalkSpeed(input.Position.X)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliderDragging = false
		end
	end)
	
	updateWalkSpeed(speedTrack.AbsolutePosition.X)
	
end
